<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@color/cf_panel"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="30dp">

    <TextView
        android:id="@+id/scanTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="扫码输入"
        android:textColor="@color/cf_text"
        android:textSize="19sp"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:paddingTop="8dp"
        android:text="手机扫二维码输入，内容直接填到电视上（需同一局域网）"
        android:textColor="@color/cf_text_dim"
        android:textSize="13sp" />

    <ImageView
        android:id="@+id/scanQr"
        android:layout_width="280dp"
        android:layout_height="280dp"
        android:layout_marginTop="16dp"
        android:background="@android:color/white"
        android:contentDescription="@null"
        android:padding="10dp" />

    <TextView
        android:id="@+id/scanUrl"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:maxWidth="460dp"
        android:paddingTop="10dp"
        android:textColor="@color/cf_text_dim"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/scanCancelBtn"
        style="@style/CfChip"
        android:layout_marginTop="18dp"
        android:text="取消" />
</LinearLayout>
