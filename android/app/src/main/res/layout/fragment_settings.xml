<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:id="@+id/settingsState"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/cf_accent"
            android:textSize="15sp" />

        <TextView
            style="@style/CfLabel"
            android:text="TMDB API Key 或 Read Access Token" />

        <EditText
            android:id="@+id/credentialInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cf_card"
            android:hint="粘贴 TMDB v3 API Key，或以 eyJ... 开头的 Read Access Token"
            android:inputType="textMultiLine"
            android:maxLines="3"
            android:padding="14dp"
            android:textColor="@color/cf_text"
            android:textColorHint="@color/cf_text_dim"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/credentialScanBtn"
                style="@style/CfChip"
                android:text="扫码输入" />

            <TextView
                android:id="@+id/credentialSaveBtn"
                style="@style/CfChip"
                android:text="保存凭据" />

            <TextView
                android:id="@+id/credentialClearBtn"
                style="@style/CfChip"
                android:text="清除凭据" />
        </LinearLayout>

        <TextView
            style="@style/CfLabel"
            android:text="代理地址" />

        <EditText
            android:id="@+id/proxyInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cf_card"
            android:hint="system 或 http://127.0.0.1:7890 / socks5://127.0.0.1:7890"
            android:inputType="text"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/cf_text"
            android:textColorHint="@color/cf_text_dim"
            android:textSize="15sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/proxyScanBtn"
                style="@style/CfChip"
                android:text="扫码输入" />

            <TextView
                android:id="@+id/proxySaveBtn"
                style="@style/CfChip"
                android:text="保存代理" />
        </LinearLayout>

        <TextView
            style="@style/CfLabel"
            android:text="介绍页资源查找模式" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/modeChips"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:focusable="false" />

        <TextView
            style="@style/CfLabel"
            android:text="自定义外部源导入（TVBox 配置 / JSON / name|api 行 / 配置 URL）" />

        <EditText
            android:id="@+id/sourcesInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/cf_card"
            android:hint="粘贴 TVBox 配置、JSON 数组、单行 name|api|modes|note，或配置 URL"
            android:inputType="textMultiLine"
            android:maxLines="5"
            android:padding="14dp"
            android:textColor="@color/cf_text"
            android:textColorHint="@color/cf_text_dim"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="10dp">

            <TextView
                android:id="@+id/sourcesScanBtn"
                style="@style/CfChip"
                android:text="扫码输入" />

            <TextView
                android:id="@+id/sourcesImportBtn"
                style="@style/CfChip"
                android:text="导入并刷新" />

            <TextView
                android:id="@+id/sourcesClearBtn"
                style="@style/CfChip"
                android:text="清空自定义源" />
        </LinearLayout>

        <TextView
            android:id="@+id/sourcesInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="14dp"
            android:textColor="@color/cf_text_dim"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingTop="26dp">

            <TextView
                android:id="@+id/testConnectionBtn"
                style="@style/CfChip"
                android:text="测试连接" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
