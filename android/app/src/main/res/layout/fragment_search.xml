<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <EditText
            android:id="@+id/searchInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@color/cf_card"
            android:hint="输入片名，回车或点搜索"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:padding="14dp"
            android:singleLine="true"
            android:textColor="@color/cf_text"
            android:textColorHint="@color/cf_text_dim"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/searchGoBtn"
            style="@style/CfChip"
            android:layout_marginStart="12dp"
            android:text="搜索" />

        <TextView
            android:id="@+id/searchScanBtn"
            style="@style/CfChip"
            android:text="扫码输入" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/searchGrid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipChildren="false"
            android:clipToPadding="false"
            android:paddingTop="16dp" />

        <TextView
            android:id="@+id/searchStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/cf_text_dim"
            android:textSize="15sp" />
    </FrameLayout>
</LinearLayout>
